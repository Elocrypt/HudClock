<Project>

  <!--
    Resolve the Vintage Story install directory.
    Order of precedence:
      1. Per-call / IDE-provided VintagestoryDir property (highest).
      2. VINTAGE_STORY environment variable.
      3. Platform-specific fallback (developer machine default).
  -->
  <PropertyGroup>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND '$(OS)' == 'Windows_NT'">F:\VintageStory\Client_v1.22.7\Vintagestory</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == '' AND '$(OS)' != 'Windows_NT'">$(HOME)/.local/share/Vintagestory</VintagestoryDir>
  </PropertyGroup>

  <!--
    Resolve the Vintage Story user data directory (where Mods/, ModConfig/, Saves/ live).
    Order of precedence:
      1. Per-call / IDE-provided VintagestoryData property (highest).
      2. VINTAGE_STORY_DATA environment variable.
      3. Fallback on Windows: '$(VintagestoryDir)\v', which matches the launchSettings
         datapath argument "." + backslash + "v" used by the 'Vintage Story' F5 profile.
         On Linux, fallback to the conventional ~/.config/VintagestoryData.
  -->
  <PropertyGroup>
    <VintagestoryData Condition="'$(VintagestoryData)' == '' AND '$(VINTAGE_STORY_DATA)' != ''">$(VINTAGE_STORY_DATA)</VintagestoryData>
    <VintagestoryData Condition="'$(VintagestoryData)' == '' AND '$(OS)' == 'Windows_NT'">$(VintagestoryDir)\v</VintagestoryData>
    <VintagestoryData Condition="'$(VintagestoryData)' == '' AND '$(OS)' != 'Windows_NT'">$(HOME)/.config/VintagestoryData</VintagestoryData>
  </PropertyGroup>


  <PropertyGroup>
    <!-- Local development only. Resolved relative to this repo so it survives folder moves:
         expects the HudShelf repo as a sibling (_Mods\HudClock, _Mods\HudShelf).
         Override with the HUDSHELF_DLL env var or property if your layout differs.
         Prefers the sibling build matching this configuration, then Release, then Debug.
         An override pointing at a missing file is ignored rather than silently
         producing CS0246 on `using HudShelf;`. -->
    <_HudShelfBin>$(MSBuildThisFileDirectory)..\HudShelf\bin\</_HudShelfBin>
    <HUDSHELF_DLL Condition="'$(HUDSHELF_DLL)' != '' AND !Exists('$(HUDSHELF_DLL)')"></HUDSHELF_DLL>
    <HUDSHELF_DLL Condition="'$(HUDSHELF_DLL)' == '' AND '$(Configuration)' != '' AND Exists('$(_HudShelfBin)$(Configuration)\HudShelf.dll')">$(_HudShelfBin)$(Configuration)\HudShelf.dll</HUDSHELF_DLL>
    <HUDSHELF_DLL Condition="'$(HUDSHELF_DLL)' == '' AND Exists('$(_HudShelfBin)Release\HudShelf.dll')">$(_HudShelfBin)Release\HudShelf.dll</HUDSHELF_DLL>
    <HUDSHELF_DLL Condition="'$(HUDSHELF_DLL)' == ''">$(_HudShelfBin)Debug\HudShelf.dll</HUDSHELF_DLL>
  </PropertyGroup>

  <!-- Fail with the resolved path instead of a bare CS0246. -->
  <Target Name="HudClockCheckHudShelf" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(HUDSHELF_DLL)')"
           Text="HudShelf.dll not found at '$(HUDSHELF_DLL)'. Build _Mods\HudShelf first, or set HUDSHELF_DLL to a built HudShelf.dll." />
    <Message Importance="high" Text="[HudClock] HudShelf reference: $(HUDSHELF_DLL)" />
  </Target>

  
  <!-- Shared language + nullability settings for every project in this repo. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Emit a friendly warning if the VS install path doesn't exist on this machine. -->
  <Target Name="_WarnMissingVintagestoryDir" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(VintagestoryDir)') AND '$(IsTestProject)' != 'true'">
    <Warning Text="VintagestoryDir '$(VintagestoryDir)' does not exist. Set the VINTAGE_STORY environment variable to your Vintage Story install path." />
  </Target>

</Project>
